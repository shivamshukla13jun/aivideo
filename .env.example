# ==============================================================================
# 🌟 AI Video Studio & Anime Manga Engine - Environment Configuration (.env)
# ==============================================================================

# 1. Environment Mode: 'development' | 'production' (Default: production)
NODE_ENV=production

# 2. Server Port (Default: 5000)
PORT=5000

# ==============================================================================
# 🌐 URL Configuration (Development) - DEVELOPMENT_ Prefix
# ==============================================================================
DEVELOPMENT_CLIENT_URL=http://localhost:5173
DEVELOPMENT_SERVER_URL=http://localhost:5000
DEVELOPMENT_API_URL=http://localhost:5000/api
DEVELOPMENT_SUWAYOMI_URL=http://127.0.0.1:4567
DEVELOPMENT_OLLAMA_BASE_URL=http://127.0.0.1:11434

# ==============================================================================
# 🚀 URL Configuration (Production) - PRODUCTION_ Prefix
# ==============================================================================
PRODUCTION_CLIENT_URL=https://yourproductiondomain.com
PRODUCTION_SERVER_URL=https://yourproductiondomain.com
PRODUCTION_API_URL=https://yourproductiondomain.com/api
PRODUCTION_SUWAYOMI_URL=http://suwayomi:4567
PRODUCTION_OLLAMA_BASE_URL=http://ollama:11434

# Backward Compatibility Fallbacks (Optional)
CLIENT_URL=http://localhost:5173
SUWAYOMI_URL=http://127.0.0.1:4567
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ==============================================================================
# 🗄️ Database Connection
# ==============================================================================
# - Local MongoDB: mongodb://127.0.0.1:27017/aivideo
# - Docker: mongodb://mongodb:27017/aivideo
# - Atlas: mongodb+srv://user:pass@cluster.mongodb.net/aivideo
MONGODB_URI=mongodb://127.0.0.1:27017/aivideo

# ==============================================================================
# 🔑 API Keys
# ==============================================================================
# Google AI Studio Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# ==============================================================================
# 🤖 AI Provider: 'gemini' | 'ollama'
# ==============================================================================
AI_PROVIDER=gemini
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava
