# ==============================================================================
# 🌟 AI Video Studio & Anime Manga Engine - एकल वातावरण फ़ाइल (.env)
# ==============================================================================
# अब आपको अलग-अलग production/development फाइलों की जरूरत नहीं है।
# सिर्फ इस एक फ़ाइल में मान (Values) बदलकर आप इसे लोकल या लाइव सर्वर पर चला सकते हैं।

# 1. बैकएंड सर्वर पोर्ट (Default: 5000)
PORT=5000

# 2. फ्रंटएंड क्लाइंट URL (CORS अनुमति के लिए)
# - लोकल डेवलपमेंट में: http://localhost:5173
# - लाइव सर्वर या डॉकर में: http://your-server-ip या https://yourdomain.com
CLIENT_URL=http://localhost:5173

# 3. Suwayomi (Tachidesk Manga/Anime Server) URL
# - लोकल कंप्यूटर पर: http://127.0.0.1:4567
# - डॉकर कम्पोज़ में: http://suwayomi:4567
SUWAYOMI_URL=http://127.0.0.1:4567

# 4. MongoDB डेटाबेस कनेक्शन स्ट्रिंग
# - लोकल कंप्यूटर पर: mongodb://127.0.0.1:27017/aivideo
# - डॉकर कम्पोज़ में: mongodb://mongodb:27017/aivideo
# - क्लाउड / Atlas: mongodb+srv://user:pass@cluster.mongodb.net/aivideo
MONGODB_URI=mongodb://127.0.0.1:27017/aivideo

# 5. Google AI Studio Gemini API Key
# इसे https://aistudio.google.com/app/apikey से मुफ्त में बनाएं (AIzaSy... से शुरू होती है)
GEMINI_API_KEY=
