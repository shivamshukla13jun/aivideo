# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"


MONGODB_URI="mongodb://localhost:27017/webtoon_studio"
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"
CLOUDINARY_CLOUD_NAME="demo_cloud"
CLOUDINARY_API_KEY="demo_key"
CLOUDINARY_API_SECRET="demo_secret"
GOOGLE_CLIENT_ID="demo_google_client_id"
GOOGLE_CLIENT_SECRET="demo_google_client_secret"
TTS_PROVIDER_API_KEY="demo_tts_key"
UPLOAD_CONCURRENCY=4
SUPER_ADMIN_EMAIL="admin@webtoonstudio.com"
SUPER_ADMIN_PASSWORD="Admin@12345"
SUPER_ADMIN_NAME="Super Admin"

