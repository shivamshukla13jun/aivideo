# MinIO object storage (all files: CBZ archives, page images, audio, covers)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="webtoon"

# MongoDB
MONGODB_URI=""

# RabbitMQ (optional — OCR jobs run synchronously without it)
RABBITMQ_URL=""
RABBITMQ_PRODUCTION_URL=""

# PaddleOCR sidecar (docker compose service "paddleocr")
# OCR + image preprocessing + Hindi translation (all self-hosted, no API key needed)
PADDLEOCR_URL="http://localhost:5004"

# Gemini API key — used ONLY for YouTube SEO metadata generation (title/tags/description).
# NOT needed for OCR or translation (those run on the self-hosted PaddleOCR server).
GEMINI_API_KEY=""

# Google OAuth for YouTube publishing & analytics.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
