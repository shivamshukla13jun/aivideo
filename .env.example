# MinIO object storage (all files: CBZ archives, page images, audio, covers)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="webtoon"

# MongoDB
MONGODB_URI=""

# RabbitMQ (optional — OCR jobs run synchronously without it)
RABBITMQ_URL=""
RABBITMQ_PRODUCTION_URL=""

# PaddleOCR sidecar (docker compose service "paddleocr")
# OCR + image preprocessing + Hindi translation (all self-hosted, no API key needed)
PADDLEOCR_URL="http://localhost:5004"

# Gemini API keys — NOT set here. Add them in the app at /settings (stored in
# MongoDB, multiple keys supported with automatic quota failover). Used for
# Hindi translation and YouTube SEO — OCR itself runs on the PaddleOCR server.

# Ollama daemon — optional local AI provider (switch in the navbar or /settings).
# Only the models in the /settings chain are pulled, downloaded on demand.
OLLAMA_URL="http://localhost:11434"

# Google OAuth for YouTube publishing & analytics.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
